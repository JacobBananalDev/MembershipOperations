<Window x:Class="MembershipOperations.Client.Views.EditMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Member" Height="400" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Edit Member"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 14"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Id, StringFormat=Member ID: {0}}"
                   Opacity="0.75"
                   Margin="0 0 0 12"/>

        <StackPanel Grid.Row="2" Margin="0 0 0 10">
            <TextBlock Text="First Name" Margin="0 0 0 6"/>
            <TextBox Height="32"
                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0 0 0 10">
            <TextBlock Text="Last Name" Margin="0 0 0 6"/>
            <TextBox Height="32"
                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0 0 0 10">
            <TextBlock Text="Email (optional)" Margin="0 0 0 6"/>
            <TextBox Height="32"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <CheckBox Grid.Row="5"
                  Content="Active"
                  IsChecked="{Binding IsActive}"
                  Margin="0 6 0 0"/>

        <TextBlock Grid.Row="6"
                   Margin="0 10 0 0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Opacity="0.75"/>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 16 0 0">
            <Button Content="Cancel"
                    Width="90"
                    Margin="0 0 10 0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Save"
                    Width="110"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
